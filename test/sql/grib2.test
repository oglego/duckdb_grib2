# name: test/sql/grib2.test
# description: test grib2 extension
# group: [sql]

# Before we load the extension, this will fail
statement error
SELECT grib2_eccodes_version();
----
Catalog Error: Scalar Function with name grib2_eccodes_version does not exist!

# Require statement will ensure this test is run with this extension loaded
require grib2

# Confirm ecCodes is linked and callable (returns e.g. 2.38.0)
query I
SELECT regexp_matches(grib2_eccodes_version(), '^\d+\.\d+\.\d+$');
----
true

# Decode spike: decode one GRIB2 message (complex packing with spatial differencing)
# from an in-memory blob. This confirms ecCodes definitions and the packing codec work.
query I
SELECT grib2_message_info(content) FROM read_blob('test/data/sample.grib2');
----
edition=2;shortName=t;typeOfLevel=surface;level=0;gridType=regular_ll;Ni=16;Nj=31;numberOfPoints=496;packingType=grid_complex_spatial_differencing;alternativeRowScanning=0;values=496;min=250.000;max=299.500

# Garbage input is rejected cleanly
statement error
SELECT grib2_message_info('not a grib message'::BLOB);
----
not a valid GRIB message

# NULL in, NULL out
query I
SELECT grib2_message_info(NULL::BLOB) IS NULL;
----
true

# Real NOAA NBM message (CONUS 2 m temperature): Lambert grid, ~3.7M points, complex spatial differencing
query I
SELECT grib2_message_info(content) FROM read_blob('fixtures/nbm_msg.grib2');
----
edition=2;shortName=2t;typeOfLevel=heightAboveGround;level=2;gridType=lambert;Ni=2345;Nj=1597;numberOfPoints=3744965;packingType=grid_complex_spatial_differencing;alternativeRowScanning=1;values=3744965;min=262.100;max=307.700

# Point extraction on the real NBM message. Expected values come from ecCodes' own nearest-point lookup.
# This grid stores every other row east to west (alternativeRowScanning = 1), so rows are mirrored in the raw
# "values" array. Springfield, MO sits on an odd row: the raw array would give 292.9, the correct value is 291.5.
query I
SELECT round(grib2_point_value(content, 37.2090, -93.2923), 1) FROM read_blob('fixtures/nbm_msg.grib2');
----
291.5

query I
SELECT round(grib2_point_value(content, 39.77, -116.85), 1) FROM read_blob('fixtures/nbm_msg.grib2');
----
281.5

query I
SELECT round(grib2_point_value(content, 44.40, -97.14), 1) FROM read_blob('fixtures/nbm_msg.grib2');
----
290.9

# An even row, where stored order and canonical order agree
query I
SELECT round(grib2_point_value(content, 31.24, -93.88), 1) FROM read_blob('fixtures/nbm_msg.grib2');
----
292.7

# Longitudes may use either convention
query I
SELECT round(grib2_point_value(content, 37.2090, 266.7077), 1) FROM read_blob('fixtures/nbm_msg.grib2');
----
291.5

# Points outside the grid return NULL
query I
SELECT grib2_point_value(content, 10.0, -100.0) IS NULL FROM read_blob('fixtures/nbm_msg.grib2');
----
true

# Grids other than Lambert are rejected clearly for now
statement error
SELECT grib2_point_value(content, 0.0, 0.0) FROM read_blob('test/data/sample.grib2');
----
is not supported yet

statement error
SELECT grib2_point_value('not a grib message'::BLOB, 0.0, 0.0);
----
not a valid GRIB message

# The other NBM regions use other projections but the same stored-row order. Expected values come from ecCodes'
# nearest-point lookup. On odd rows the raw "values" array differs from the correct value (noted as raw below).

# Alaska: polar stereographic (odd row; raw 273.3)
query I
SELECT round(grib2_point_value(content, 58.0874, -154.1681), 1) FROM read_blob('fixtures/nbm_ak_msg.grib2');
----
275.7

# Alaska, even row, west of the antimeridian
query I
SELECT round(grib2_point_value(content, 63.8585, -170.2528), 1) FROM read_blob('fixtures/nbm_ak_msg.grib2');
----
272.3

# Hawaii: Mercator (odd row; raw 298.7)
query I
SELECT round(grib2_point_value(content, 22.005, -154.4903), 1) FROM read_blob('fixtures/nbm_hi_msg.grib2');
----
298.9

query I
SELECT round(grib2_point_value(content, 18.0725, -158.4858), 1) FROM read_blob('fixtures/nbm_hi_msg.grib2');
----
299.7

# Puerto Rico: Mercator (odd row; raw 307.7)
query I
SELECT round(grib2_point_value(content, 17.7425, -66.4248), 1) FROM read_blob('fixtures/nbm_pr_msg.grib2');
----
308.0

query I
SELECT round(grib2_point_value(content, 18.5269, -66.6641), 1) FROM read_blob('fixtures/nbm_pr_msg.grib2');
----
305.1

# Guam: Mercator, CAPE (odd row; raw 1409.0)
query I
SELECT round(grib2_point_value(content, 13.818, 147.0361), 1) FROM read_blob('fixtures/nbm_gu_msg.grib2');
----
969.0

query I
SELECT round(grib2_point_value(content, 14.8148, 146.5576), 1) FROM read_blob('fixtures/nbm_gu_msg.grib2');
----
678.0

# Outside each grid returns NULL
query I
SELECT grib2_point_value(content, 0.0, 0.0) IS NULL FROM read_blob('fixtures/nbm_ak_msg.grib2');
----
true

query I
SELECT grib2_point_value(content, 40.0, -100.0) IS NULL FROM read_blob('fixtures/nbm_hi_msg.grib2');
----
true

# grib2_index with the .idx sidecar. test/data/multi.grib2.idx is a synthetic inventory for four messages on three grids.
query IIITTTT
SELECT message_number, byte_offset, byte_length, variable, level, forecast, strftime(reference_time, '%Y-%m-%d %H:%M') FROM grib2_index('test/data/multi.grib2') ORDER BY message_number;
----
1	0	35188	CAPE	surface	1 hour fcst	2026-10-23 00:00
2	35188	27859	APTMP	2 m above ground	1 hour fcst	2026-10-23 00:00
3	63047	100044	APTMP	2 m above ground	1 hour fcst	2026-10-23 00:00
4	163091	277	T	surface	anl	2026-01-01 00:00

query ITIT
SELECT message_number, inventory, step_hours, qualifier FROM grib2_index('test/data/multi.grib2') ORDER BY message_number;
----
1	CAPE:surface:1 hour fcst	1	(empty)
2	APTMP:2 m above ground:1 hour fcst	1	(empty)
3	APTMP:2 m above ground:1 hour fcst	1	(empty)
4	T:surface:anl	0	(empty)

# The inventory column is meant for Herbie-style searching
query I
SELECT message_number FROM grib2_index('test/data/multi.grib2') WHERE inventory LIKE 'APTMP:2 m above ground:%' ORDER BY message_number;
----
2
3

# Without details the sidecar is trusted: no section or ecCodes columns
query III
SELECT count(*), count(discipline), count(short_name) FROM grib2_index('test/data/multi.grib2');
----
4	0	0

# idx := false hops through the file using the length in each indicator section. There are no names, but the
# section headers give the parameter numbers, grid template and packing, and the reference time.
query IIIIIIIIITT
SELECT message_number, byte_offset, byte_length, variable IS NULL, discipline, parameter_category, parameter_number, grid_template, packing_template, packing_type, strftime(reference_time, '%Y-%m-%d %H:%M') FROM grib2_index('test/data/multi.grib2', idx := false) ORDER BY message_number;
----
1	0	35188	true	0	7	6	10	3	grid_complex_spatial_differencing	2026-10-23 00:00
2	35188	27859	true	0	0	21	10	3	grid_complex_spatial_differencing	2026-10-23 00:00
3	63047	100044	true	0	0	21	10	3	grid_complex_spatial_differencing	2026-10-23 00:00
4	163091	277	true	0	0	0	0	3	grid_complex_spatial_differencing	2026-01-01 00:00

# details := true asks ecCodes for names, level and grid details from a short prefix of each message
query ITTRTIIIT
SELECT message_number, short_name, type_of_level, level_value, grid_type, ni, nj, alternative_row_scanning, packing_type FROM grib2_index('test/data/multi.grib2', details := true) ORDER BY message_number;
----
1	cape	surface	0.000	mercator	193	193	true	grid_complex_spatial_differencing
2	aptmp	heightAboveGround	2.000	mercator	339	225	true	grid_complex_spatial_differencing
3	aptmp	heightAboveGround	2.000	mercator	625	561	true	grid_complex_spatial_differencing
4	t	surface	0.000	regular_ll	16	31	false	grid_complex_spatial_differencing

# Both together, and a single real NBM message with no sidecar
query IIIIIITT
SELECT message_number, byte_offset, byte_length, variable IS NULL, grid_template, packing_template, short_name, grid_type FROM grib2_index('fixtures/nbm_msg.grib2', details := true);
----
1	0	2099312	true	30	3	2t	lambert

query TTIII
SELECT short_name, grid_type, ni, nj, grid_template FROM grib2_index('fixtures/nbm_ak_msg.grib2', details := true);
----
aptmp	polar_stereographic	1649	1105	20

# Globs expand to several files, in path order
query II
SELECT count(*), count(DISTINCT file_path) FROM grib2_index('fixtures/nbm_*_msg.grib2');
----
4	4

query TI
SELECT file_path, message_number FROM grib2_index('fixtures/nbm_*_msg.grib2') ORDER BY file_path;
----
fixtures/nbm_ak_msg.grib2	1
fixtures/nbm_gu_msg.grib2	1
fixtures/nbm_hi_msg.grib2	1
fixtures/nbm_pr_msg.grib2	1

# Errors
statement error
SELECT * FROM grib2_index('test/data/no_such_file.grib2');
----
No files found


statement error
SELECT * FROM grib2_index('test/data/multi.grib2.idx', idx := false);
----
missing the GRIB marker


# An .idx whose offsets do not match the file is caught instead of silently giving wrong offsets
statement error
SELECT * FROM grib2_index('test/data/stale.grib2');
----
belong to this file

query I
SELECT count(*) FROM grib2_index('test/data/stale.grib2', idx := false);
----
2
