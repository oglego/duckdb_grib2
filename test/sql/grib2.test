# name: test/sql/grib2.test
# description: test grib2 extension
# group: [sql]

# Before we load the extension, this will fail
statement error
SELECT grib2_eccodes_version();
----
Catalog Error: Scalar Function with name grib2_eccodes_version does not exist!

# Require statement will ensure this test is run with this extension loaded
require grib2

# Confirm ecCodes is linked and callable (returns e.g. 2.38.0)
query I
SELECT regexp_matches(grib2_eccodes_version(), '^\d+\.\d+\.\d+$');
----
true

# Decode spike: decode one GRIB2 message (complex packing with spatial differencing)
# from an in-memory blob. This confirms ecCodes definitions and the packing codec work.
query I
SELECT grib2_message_info(content) FROM read_blob('test/data/sample.grib2');
----
edition=2;shortName=t;typeOfLevel=surface;level=0;gridType=regular_ll;Ni=16;Nj=31;numberOfPoints=496;packingType=grid_complex_spatial_differencing;alternativeRowScanning=0;values=496;min=250.000;max=299.500

# Garbage input is rejected cleanly
statement error
SELECT grib2_message_info('not a grib message'::BLOB);
----
not a valid GRIB message

# NULL in, NULL out
query I
SELECT grib2_message_info(NULL::BLOB) IS NULL;
----
true

# Real NOAA NBM message (CONUS 2 m temperature): Lambert grid, ~3.7M points, complex spatial differencing
query I
SELECT grib2_message_info(content) FROM read_blob('fixtures/nbm_msg.grib2');
----
edition=2;shortName=2t;typeOfLevel=heightAboveGround;level=2;gridType=lambert;Ni=2345;Nj=1597;numberOfPoints=3744965;packingType=grid_complex_spatial_differencing;alternativeRowScanning=1;values=3744965;min=262.100;max=307.700

# Point extraction on the real NBM message. Expected values come from ecCodes' own nearest-point lookup.
# This grid stores every other row east to west (alternativeRowScanning = 1), so rows are mirrored in the raw
# "values" array. Springfield, MO sits on an odd row: the raw array would give 292.9, the correct value is 291.5.
query I
SELECT round(grib2_point_value(content, 37.2090, -93.2923), 1) FROM read_blob('fixtures/nbm_msg.grib2');
----
291.5

query I
SELECT round(grib2_point_value(content, 39.77, -116.85), 1) FROM read_blob('fixtures/nbm_msg.grib2');
----
281.5

query I
SELECT round(grib2_point_value(content, 44.40, -97.14), 1) FROM read_blob('fixtures/nbm_msg.grib2');
----
290.9

# An even row, where stored order and canonical order agree
query I
SELECT round(grib2_point_value(content, 31.24, -93.88), 1) FROM read_blob('fixtures/nbm_msg.grib2');
----
292.7

# Longitudes may use either convention
query I
SELECT round(grib2_point_value(content, 37.2090, 266.7077), 1) FROM read_blob('fixtures/nbm_msg.grib2');
----
291.5

# Points outside the grid return NULL
query I
SELECT grib2_point_value(content, 10.0, -100.0) IS NULL FROM read_blob('fixtures/nbm_msg.grib2');
----
true

# Grids other than Lambert are rejected clearly for now
statement error
SELECT grib2_point_value(content, 0.0, 0.0) FROM read_blob('test/data/sample.grib2');
----
is not supported yet

statement error
SELECT grib2_point_value('not a grib message'::BLOB, 0.0, 0.0);
----
not a valid GRIB message

# The other NBM regions use other projections but the same stored-row order. Expected values come from ecCodes'
# nearest-point lookup. On odd rows the raw "values" array differs from the correct value (noted as raw below).

# Alaska: polar stereographic (odd row; raw 273.3)
query I
SELECT round(grib2_point_value(content, 58.0874, -154.1681), 1) FROM read_blob('fixtures/nbm_ak_msg.grib2');
----
275.7

# Alaska, even row, west of the antimeridian
query I
SELECT round(grib2_point_value(content, 63.8585, -170.2528), 1) FROM read_blob('fixtures/nbm_ak_msg.grib2');
----
272.3

# Hawaii: Mercator (odd row; raw 298.7)
query I
SELECT round(grib2_point_value(content, 22.005, -154.4903), 1) FROM read_blob('fixtures/nbm_hi_msg.grib2');
----
298.9

query I
SELECT round(grib2_point_value(content, 18.0725, -158.4858), 1) FROM read_blob('fixtures/nbm_hi_msg.grib2');
----
299.7

# Puerto Rico: Mercator (odd row; raw 307.7)
query I
SELECT round(grib2_point_value(content, 17.7425, -66.4248), 1) FROM read_blob('fixtures/nbm_pr_msg.grib2');
----
308.0

query I
SELECT round(grib2_point_value(content, 18.5269, -66.6641), 1) FROM read_blob('fixtures/nbm_pr_msg.grib2');
----
305.1

# Guam: Mercator, CAPE (odd row; raw 1409.0)
query I
SELECT round(grib2_point_value(content, 13.818, 147.0361), 1) FROM read_blob('fixtures/nbm_gu_msg.grib2');
----
969.0

query I
SELECT round(grib2_point_value(content, 14.8148, 146.5576), 1) FROM read_blob('fixtures/nbm_gu_msg.grib2');
----
678.0

# Outside each grid returns NULL
query I
SELECT grib2_point_value(content, 0.0, 0.0) IS NULL FROM read_blob('fixtures/nbm_ak_msg.grib2');
----
true

query I
SELECT grib2_point_value(content, 40.0, -100.0) IS NULL FROM read_blob('fixtures/nbm_hi_msg.grib2');
----
true
