# name: test/sql/read_grib2.test
# description: test read_grib2 extension
# group: [sql]

# Before we load the extension, this will fail
statement error
SELECT read_grib2('Sam');
----
Catalog Error: Scalar Function with name read_grib2 does not exist!

# Require statement will ensure this test is run with this extension loaded
require read_grib2

# Confirm the extension works
query I
SELECT read_grib2('Sam');
----
...........🦆 Sam

query I
SELECT read_grib2_openssl_version('Michael') ILIKE 'ReadGrib2 Michael, my linked OpenSSL version is OpenSSL%';
----
true
